# העתק לקובץ .env ומלא ערכים אמיתיים

# חיבור ל-Postgres. ב-Neon: Dashboard > Connection string > Pooled connection.
# חובה שיכלול sslmode=require.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# מפתח חתימה ל-JWT. חובה בפריסה.
# ייצור מפתח: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# סיסמת המנהל הראשונית. נקראת פעם אחת בלבד — כשעדיין אין חשבון מנהל בבסיס הנתונים.
ADMIN_PASSWORD=
ADMIN_NAME=מנהל

# --- אופציונלי ---

# סביבה: development | production
NODE_ENV=development

# פורט השרת בהרצה מקומית
PORT=4000

# משך תוקף החיבור (ברירת מחדל 8h)
SESSION_TTL=8h

# הסכימה שבה יושבות הטבלאות (ברירת מחדל public)
DB_SCHEMA=public

# מספר החיבורים המרבי ב-pool לכל instance (ברירת מחדל 3)
PG_POOL_MAX=3
