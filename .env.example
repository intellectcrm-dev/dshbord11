# העתק לקובץ .env ומלא ערכים אמיתיים

# סביבה: development | production
NODE_ENV=development

# פורט השרת
PORT=4000

# מפתח חתימה ל-JWT. חובה ב-production.
# ייצור מפתח: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# משך תוקף החיבור (ברירת מחדל 8h)
SESSION_TTL=8h

# מיקום קובץ בסיס הנתונים
DB_FILE=data/dashboard.db

# סיסמת המנהל הראשונית - נקראת רק כשבסיס הנתונים ריק (יצירת חשבון המנהל הראשון)
ADMIN_PASSWORD=
ADMIN_NAME=מנהל
